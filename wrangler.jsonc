{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "muratyamac-bio",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  // Runs before every deploy/dev, so dist/ exists in Workers Builds too.
  "build": { "command": "npm run build", "watch_dir": ["src", "public", "index.html"] },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Hot Wheels collection (WDS LLC account). The Worker only runs SELECTs.
  // remote: local `wrangler dev` reads the real database instead of an empty local copy.
  "d1_databases": [
    { "binding": "WHEELS", "database_name": "muratwheels", "database_id": "0067e684-3d9a-4abe-8c63-48b937f06ae9", "remote": true }
  ],
  "observability": { "enabled": true }
  // Secrets: none yet. Add with `wrangler secret put NAME` — never here.
}
